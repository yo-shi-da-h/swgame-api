{
  "version": 2,
  "builds": [
    {
      "src": "app.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app.ts"
    }
  ]
}
{
  "buildCommand": "prisma generate && tsc",
  "outputDirectory": "dist",
  "includeFiles": ["node_modules/.prisma/client/**"]
}
